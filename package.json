{
  "name": "maiden",
  "version": "0.0.0",
  "private": true,
  "description": "Maiden — a historical cricket strategy/simulation game. Phase 0: project foundation.",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=26",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "pnpm --filter @maiden/web dev",
    "dev:api": "pnpm --filter @maiden/api dev",
    "simulate": "pnpm --filter @maiden/simulator simulate",
    "draft": "tsx scripts/maiden-draft.ts",
    "campaign": "tsx scripts/campaign.ts",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "python:test": ".venv/bin/python -m pytest",
    "python:lint": ".venv/bin/python -m ruff check data-pipeline tests scripts",
    "python:format": ".venv/bin/python -m ruff format data-pipeline tests scripts",
    "python:format:check": ".venv/bin/python -m ruff format --check data-pipeline tests scripts",
    "data:download": ".venv/bin/python scripts/download_cricsheet.py",
    "data:build": ".venv/bin/python scripts/build_database.py",
    "data:validate": ".venv/bin/python scripts/validate_database.py"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.1",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  }
}
