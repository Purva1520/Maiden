# ---- Node / JavaScript / TypeScript ----
node_modules/
dist/
build/
.vite/
coverage/
*.tsbuildinfo

# ---- Python ----
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
.mypy_cache/

# ---- Environment ----
.env
.env.*
!.env.example

# ---- OS / editor ----
.DS_Store
.vscode/
.idea/
*.swp

# ---- Logs ----
*.log
npm-debug.log*
pnpm-debug.log*

# ---- Data policy ----
# Raw, externally sourced datasets are large and/or licensed and must NOT be
# committed. Generated/processed artifacts are also ignored by default. Small,
# curated game-ready data files may be committed intentionally: add explicit
# `!` un-ignore rules here when Phase 2+ introduces them.
data/raw/*
data/processed/*
!data/**/.gitkeep
!data/**/README.md
