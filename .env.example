# Maiden environment variables — copy this file to `.env` and adjust locally.
# `.env` is git-ignored; never commit real secrets. In Phase 0 there are no
# secrets — these are development-time defaults only.

# Node runtime mode. Required by the API. One of: development | test | production
NODE_ENV=development

# Port the API (apps/api, Fastify) listens on. Required by the API.
API_PORT=3000

# Port the web dev server (apps/web, Vite) listens on. Optional; Vite defaults
# to 5173 if unset.
WEB_PORT=5173

# Base URL the web app (Phase 10 frontend) uses to reach the Maiden API.
# Optional; defaults to http://localhost:3000 if unset. Must match API_PORT.
VITE_API_BASE_URL=http://localhost:3000

# Database connection string. Optional / unused in Phase 0 — reserved for a
# later phase. Leave blank.
DATABASE_URL=
